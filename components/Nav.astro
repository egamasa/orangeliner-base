---
import logo from '../assets/orangeliner_logo_2022_accent.svg';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  subTitle?: string;
  links?: NavLink[];
}

const defaultLinks: NavLink[] = [
  {
    href: 'https://orangeliner.net/contents/',
    label: 'Contents',
  },
  {
    href: 'https://orangeliner.net/apps/',
    label: 'Apps',
  },
  {
    href: 'https://orangeliner.net/tools/',
    label: 'Tools',
  },
  {
    href: 'https://blog.orangeliner.net',
    label: 'Blog',
  },
];

const { subTitle, links = defaultLinks } = Astro.props;
const siteName = 'orangeliner.net';
const altText = subTitle ? `${siteName} ${subTitle}` : siteName;

const currentOrigin = Astro.site?.origin ?? '';

function resolve(url: string): string {
  if (currentOrigin && url.startsWith(currentOrigin)) {
    return new URL(url).pathname;
  }
  return url;
}
---

<nav class="relative flex flex-wrap items-center justify-between">
  <div>
    <a href="/" class="flex items-center gap-2 p-3 md:px-8">
      <img src={logo.src} alt={altText} class="h-6 md:h-8 w-auto max-w-[260px]">
      {subTitle && <span class="font-bold text-sm">{subTitle}</span>}
    </a>
  </div>

  <!-- Hamburger button (mobile only) -->
  <button
    id="menu-toggle"
    type="button"
    class="cursor-pointer p-3 md:hidden"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="nav-menu"
  >
    <svg
      id="menu-icon-open"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg
      id="menu-icon-close"
      class="hidden h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Nav links -->
  <div
    id="nav-menu"
    class="absolute top-full right-0 z-50 hidden border-t-2 border-[var(--color-header-border)] bg-[var(--color-header-bg)] md:relative md:flex md:items-center md:border-t-0 md:bg-transparent md:mr-8"
  >
    {links.map((link: NavLink) => (
      <a href={resolve(link.href)} class="block px-3 py-2 text-lg">{link.label}</a>
    ))}
    <label class="swap swap-rotate p-3" aria-label="テーマ切替">
      <input id="theme-toggle" type="checkbox">
      <!-- sun icon (shown when dark, click to switch to light) -->
      <svg
        class="swap-on h-6 w-6 fill-current"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,17.05a1,1,0,0,0,0,1.41l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
        />
      </svg>
      <!-- moon icon (shown when light, click to switch to dark) -->
      <svg
        class="swap-off h-6 w-6 fill-current"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
        />
      </svg>
    </label>
  </div>
</nav>

<script>
// Hamburger menu toggle
const menuToggle = document.getElementById('menu-toggle');
const navMenu = document.getElementById('nav-menu');
const iconOpen = document.getElementById('menu-icon-open');
const iconClose = document.getElementById('menu-icon-close');

if (menuToggle && navMenu && iconOpen && iconClose) {
  menuToggle.addEventListener('click', () => {
    const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!expanded));
    navMenu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  });
}

// Theme toggle
const toggle = document.getElementById('theme-toggle') as HTMLInputElement;

function getTheme(): string {
  return localStorage.getItem('theme') || 'system';
}

function isDark(): boolean {
  const theme = getTheme();
  if (theme === 'dark') return true;
  if (theme === 'light') return false;
  return window.matchMedia('(prefers-color-scheme: dark)').matches;
}

function applyTheme(theme: string) {
  const root = document.documentElement;
  if (theme === 'dark') {
    root.setAttribute('data-theme', 'dim');
  } else if (theme === 'light') {
    root.setAttribute('data-theme', 'emerald');
  } else {
    root.removeAttribute('data-theme');
  }
  toggle.checked = isDark();
}

toggle.addEventListener('change', () => {
  const next = toggle.checked ? 'dark' : 'light';
  localStorage.setItem('theme', next);
  applyTheme(next);
});

applyTheme(getTheme());
</script>
